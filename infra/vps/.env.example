# AI Career Agent - INFRA-001 VPS test environment
# Copy this file to the repository root as .env and replace every CHANGE_ME.
# Never commit the resulting .env file.

# Application identity
APP_ENV=production
APP_VERSION=infra-001-test
SERVICE_NAME=ai-career-agent

# Temporary test hostname. Point its A record to the VPS public IPv4 before
# enabling the tls profile. Replace it later during DOMAIN-001.
VPS_TEST_HOST=infra-test.example.com
ACME_EMAIL=ops@example.com
TRUSTED_HOSTS=infra-test.example.com
TRUST_PROXY_HEADERS=1
FORWARDED_ALLOW_IPS=*

# Direct IP test. Use 0.0.0.0 only during the controlled VPS connectivity test.
# Switch to 127.0.0.1 when Caddy is enabled.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PUBLISH_PORT=8000

# PostgreSQL in the private Docker network
POSTGRES_USER=ai_career_agent
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_DB=ai_career_agent

# Application secrets
FLASK_SECRET_KEY=CHANGE_ME_RANDOM_64_CHARACTERS
TOKEN_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
BACKUP_ENCRYPTION_KEY=CHANGE_ME_DIFFERENT_FERNET_KEY
SYNC_SECRET=CHANGE_ME_RANDOM_SYNC_SECRET

# AUTH-001 first-party account. SMTP is provider-neutral; credentials remain
# outside GitHub. Use AUTH_EMAIL_BACKEND=disabled until SMTP is configured.
AUTH_EMAIL_BACKEND=smtp
AUTH_EMAIL_FROM=accounts@example.com
AUTH_EMAIL_FROM_NAME=AI Career Agent
AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
AUTH_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
AUTH_SMTP_USE_TLS=1
AUTH_SMTP_USE_SSL=0
AUTH_SMTP_TIMEOUT_SECONDS=8
# Optional Gmail API staging transport. Do not use as the commercial sender.
AUTH_GMAIL_CLIENT_ID=CHANGE_ME_GMAIL_OAUTH_CLIENT_ID
AUTH_GMAIL_CLIENT_SECRET=CHANGE_ME_GMAIL_OAUTH_CLIENT_SECRET
AUTH_GMAIL_REFRESH_TOKEN=CHANGE_ME_GMAIL_REFRESH_TOKEN
AUTH_GMAIL_TIMEOUT_SECONDS=8
AUTH_SESSION_TTL_SECONDS=43200
AUTH_VERIFICATION_TTL_SECONDS=86400
AUTH_RESET_TTL_SECONDS=3600
AUTH_PASSWORD_MIN_LENGTH=12

# OAuth provider credentials and callbacks
SUPERJOB_CLIENT_ID=CHANGE_ME
SUPERJOB_CLIENT_SECRET=CHANGE_ME
SUPERJOB_REDIRECT_URI=https://infra-test.example.com/oauth/superjob/callback
HH_CLIENT_ID=CHANGE_ME
HH_CLIENT_SECRET=CHANGE_ME
HH_REDIRECT_URI=https://infra-test.example.com/oauth/hh/callback
HH_USER_AGENT=AI-Career-Agent/infra-test (ops@example.com)
REED_API_KEY=

# Runtime policy. The Trudvsem worker is already a separate process/service.
# Keep one Gunicorn worker until shared limiter storage is introduced.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=90
RATELIMIT_STORAGE_URI=memory://
# SEARCH-003 bounded persistent result snapshots. Defaults are safe for Render/VPS;
# override only after measuring database size and provider latency.
SEARCH_PAGE_SIZE=20
SEARCH_SNAPSHOT_TTL_SECONDS=1800
SEARCH_SNAPSHOT_MAX_CANDIDATES=1200
SEARCH_SNAPSHOT_MAX_PAGES_PER_SOURCE=8
SEARCH_SNAPSHOT_MAX_ROUNDS_PER_REQUEST=1
SEARCH_SNAPSHOT_BUFFER_ITEMS=1
SEARCH_SNAPSHOT_EXTENSION_LEASE_SECONDS=90
TRUDVSEM_SYNC_ENABLED=0
TRUDVSEM_SYNC_INTERVAL=1800
TRUDVSEM_SYNC_ITEMS=300
TRUDVSEM_SYNC_BATCH=10
TRUDVSEM_SYNC_POLL_SECONDS=15
TRUDVSEM_SYNC_STALE_SECONDS=900
TRUDVSEM_WORKER_HEARTBEAT_SECONDS=15
TRUDVSEM_SYNC_WATERMARK_OVERLAP_SECONDS=300
TRUDVSEM_VACANCY_TTL_DAYS=45
TRUDVSEM_CLOSED_RETENTION_DAYS=30
TRUDVSEM_RETRY_BASE_SECONDS=60
TRUDVSEM_RETRY_MAX_SECONDS=3600
LOG_FORMAT=json
LOG_LEVEL=INFO

# Image label used by Docker Compose
APP_IMAGE_TAG=infra-001-test

# Isolated restore drill database used to finish OPS-001 on the candidate VPS.
RESTORE_POSTGRES_USER=restore_user
RESTORE_POSTGRES_PASSWORD=CHANGE_ME_DIFFERENT_RESTORE_PASSWORD
RESTORE_POSTGRES_DB=ai_career_agent_restore
RESTORE_DATABASE_URL=postgresql+psycopg://restore_user:CHANGE_ME_DIFFERENT_RESTORE_PASSWORD@restore-db:5432/ai_career_agent_restore
