# AI Career Agent - INFRA-001 VPS test environment
# Copy this file to the repository root as .env and replace every CHANGE_ME.
# Never commit the resulting .env file.

# Application identity
APP_ENV=production
APP_VERSION=infra-001-test
SERVICE_NAME=ai-career-agent

# Temporary test hostname. Point its A record to the VPS public IPv4 before
# enabling the tls profile. Replace it later during DOMAIN-001.
VPS_TEST_HOST=infra-test.example.com
ACME_EMAIL=ops@example.com
TRUSTED_HOSTS=infra-test.example.com
TRUST_PROXY_HEADERS=1
FORWARDED_ALLOW_IPS=*

# Direct IP test. Use 0.0.0.0 only during the controlled VPS connectivity test.
# Switch to 127.0.0.1 when Caddy is enabled.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PUBLISH_PORT=8000

# PostgreSQL in the private Docker network
POSTGRES_USER=ai_career_agent
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_DB=ai_career_agent

# Application secrets
FLASK_SECRET_KEY=CHANGE_ME_RANDOM_64_CHARACTERS
TOKEN_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
BACKUP_ENCRYPTION_KEY=CHANGE_ME_DIFFERENT_FERNET_KEY
SYNC_SECRET=CHANGE_ME_RANDOM_SYNC_SECRET

# OAuth provider credentials and callbacks
SUPERJOB_CLIENT_ID=CHANGE_ME
SUPERJOB_CLIENT_SECRET=CHANGE_ME
SUPERJOB_REDIRECT_URI=https://infra-test.example.com/oauth/superjob/callback
HH_CLIENT_ID=CHANGE_ME
HH_CLIENT_SECRET=CHANGE_ME
HH_REDIRECT_URI=https://infra-test.example.com/oauth/hh/callback
HH_USER_AGENT=AI-Career-Agent/infra-test (ops@example.com)
REED_API_KEY=

# Runtime policy. Keep one Gunicorn worker until shared limiter storage and a
# separate Trudvsem worker are implemented.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=90
RATELIMIT_STORAGE_URI=memory://
TRUDVSEM_SYNC_ENABLED=0
LOG_FORMAT=json
LOG_LEVEL=INFO

# Image label used by Docker Compose
APP_IMAGE_TAG=infra-001-test

# Isolated restore drill database used to finish OPS-001 on the candidate VPS.
RESTORE_POSTGRES_USER=restore_user
RESTORE_POSTGRES_PASSWORD=CHANGE_ME_DIFFERENT_RESTORE_PASSWORD
RESTORE_POSTGRES_DB=ai_career_agent_restore
RESTORE_DATABASE_URL=postgresql+psycopg://restore_user:CHANGE_ME_DIFFERENT_RESTORE_PASSWORD@restore-db:5432/ai_career_agent_restore
