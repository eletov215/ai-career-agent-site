{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-career-agent.local/schemas/resume-analysis-v2.2.json",
  "title": "Resume analysis output v2.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "strengths",
    "gaps",
    "recommendations",
    "facts_not_verified"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 900
    },
    "strengths": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "explanation",
          "evidence_ids"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "explanation": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][0-9]+$"
            },
            "minItems": 1,
            "maxItems": 8
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "explanation",
          "evidence_ids"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "explanation": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][0-9]+$"
            },
            "minItems": 1,
            "maxItems": 8
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "rationale",
          "evidence_ids"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "rationale": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][0-9]+$"
            },
            "minItems": 1,
            "maxItems": 8
          }
        }
      }
    },
    "facts_not_verified": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact",
          "evidence_ids"
        ],
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 4,
            "maxLength": 320
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][0-9]+$"
            },
            "minItems": 1,
            "maxItems": 4
          }
        }
      }
    }
  }
}
