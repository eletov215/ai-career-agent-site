{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-career-agent.local/schemas/cover-letter-v2.json",
  "title": "Grounded cover letter output v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "paragraphs", "caveats"],
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 5,
      "maxLength": 160
    },
    "paragraphs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text", "evidence_ids"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["opening", "candidate_fit", "closing"]
          },
          "text": {
            "type": "string",
            "minLength": 25,
            "maxLength": 900
          },
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z][0-9]+$"},
            "minItems": 1,
            "maxItems": 8
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 4, "maxLength": 320},
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z][0-9]+$"},
            "minItems": 1,
            "maxItems": 8
          }
        }
      }
    }
  }
}
