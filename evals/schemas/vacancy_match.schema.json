{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-career-agent.local/schemas/vacancy-match-v2.json",
  "title": "Vacancy match classification output v2",
  "description": "The model classifies each vacancy requirement. AI Career Agent derives the numeric score deterministically from these classifications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "matched_requirements",
    "gaps",
    "recommendation",
    "caveats"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["strong", "partial", "weak"]
    },
    "matched_requirements": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "requirement", "explanation", "evidence_ids"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^v[0-9]+$"},
          "requirement": {"type": "string", "minLength": 2, "maxLength": 180},
          "explanation": {"type": "string", "minLength": 8, "maxLength": 420},
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z][0-9]+$"},
            "minItems": 1,
            "maxItems": 8
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "requirement", "explanation", "evidence_ids"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^v[0-9]+$"},
          "requirement": {"type": "string", "minLength": 2, "maxLength": 180},
          "explanation": {"type": "string", "minLength": 8, "maxLength": 420},
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z][0-9]+$"},
            "minItems": 1,
            "maxItems": 8
          }
        }
      }
    },
    "recommendation": {
      "type": "string",
      "minLength": 15,
      "maxLength": 700
    },
    "caveats": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 4, "maxLength": 320},
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z][0-9]+$"},
            "minItems": 1,
            "maxItems": 8
          }
        }
      }
    }
  }
}
