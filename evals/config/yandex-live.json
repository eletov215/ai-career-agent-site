      "endpoint": "https://ai.api.cloud.yandex.net/v1/chat/completions",
      "api_key_env": "AI_BENCH_YANDEX_API_KEY",
      "auth_scheme": "Api-Key",
      "extra_headers_env": {
        "OpenAI-Project": "AI_BENCH_YANDEX_FOLDER_ID"
      },
      "model_env": "AI_BENCH_YANDEX_ALICE_LLM_MODEL",
      "metadata_model": "aliceai-llm/latest",
      "temperature": 0.0,
      "max_tokens": 1600,
      "response_schema_mode": "json_schema",
      "pricing_usd_per_million": {
