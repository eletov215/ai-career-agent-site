{
  "benchmark_version": "1.0",
  "fixtures_manifest": "evals/fixtures/manifest.json",
  "timeout_seconds": 90,
  "thresholds": {
    "max_error_rate": 0.05,
    "max_forbidden_claims": 0,
    "max_invalid_evidence_ids": 0,
    "max_unsupported_numbers": 0,
    "min_grounding_score": 0.85,
    "min_quality_score": 0.85,
    "min_required_path_coverage": 1.0
  },
  "providers": [
    {
      "id": "candidate-openai-compatible",
      "adapter": "openai_compatible",
      "enabled": false,
      "endpoint_env": "AI_BENCH_CANDIDATE_ENDPOINT",
      "api_key_env": "AI_BENCH_CANDIDATE_API_KEY",
      "temperature": 0.0,
      "max_tokens": 1600,
      "pricing_usd_per_million": {
        "input": 0.0,
        "output": 0.0
      },
      "auth_scheme": "Bearer",
      "model_env": "AI_BENCH_CANDIDATE_MODEL",
      "metadata_model": "approved-model-id",
      "response_schema_mode": "json_schema"
    },
    {
      "id": "candidate-command-wrapper",
      "adapter": "command",
      "enabled": false,
      "command": [
        "python",
        "path/to/provider_wrapper.py"
      ],
      "pass_env": [
        "AI_BENCH_WRAPPER_API_KEY"
      ],
      "pricing_usd_per_million": {
        "input": 0.0,
        "output": 0.0
      }
    }
  ]
}
