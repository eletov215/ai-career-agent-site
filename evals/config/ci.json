{
  "benchmark_version": "1.0",
  "fixtures_manifest": "evals/fixtures/manifest.json",
  "timeout_seconds": 10,
  "thresholds": {
    "max_error_rate": 0.0,
    "max_forbidden_claims": 0,
    "max_invalid_evidence_ids": 0,
    "max_unsupported_numbers": 0,
    "min_grounding_score": 1.0,
    "min_quality_score": 1.0,
    "min_required_path_coverage": 1.0
  },
  "providers": [
    {
      "id": "reference",
      "adapter": "fixture",
      "enabled": true,
      "outputs_dir": "evals/expected/reference"
    }
  ]
}
